{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JARVIS",
  "mainBinaryName": "jarvis",
  "identifier": "ai.jarvis.desktop",
  "build": {
    "beforeDevCommand": "pnpm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/desktop/browser"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "JARVIS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0e13"
      }
    ],
    "security": {
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:4200 http://localhost:4200",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "JARVIS project",
    "homepage": "https://github.com/RomanNikolaenko/JARVIS",
    "copyright": "Copyright © 2026 the JARVIS authors",
    "resources": {
      "../../../LICENSE-MIT": "LICENSE-MIT",
      "../../../LICENSE-APACHE": "LICENSE-APACHE",
      "../../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "category": "Productivity",
    "shortDescription": "Local-first personal AI assistant",
    "longDescription": "JARVIS is a local-first, privacy-first personal AI assistant with support for local and cloud AI models.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENkYzM0M2MkIxRkNFNjkKUldScHpoOHJ4ak52YlFKVHRPT0cwMnZDajVRR095MG9nd0lSMjBNL0lRdFQya09hbnY1SWxtcHMK",
      "endpoints": [
        "https://github.com/RomanNikolaenko/JARVIS/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
