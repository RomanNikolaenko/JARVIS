{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "IPC access for the main JARVIS window. Grants only what the UI uses; every other command is denied.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-get-health",
    "allow-get-platform-info",
    "allow-get-system-metrics",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-recent-events",
    "allow-list-ai-models",
    "allow-get-model-routes",
    "allow-test-ai-provider",
    "allow-start-chat",
    "allow-cancel-chat",
    "allow-report-ui-error"
  ]
}
