{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "IPC access for the main JARVIS window. Grants only what the UI uses; every other command is denied.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-get-health",
    "allow-get-platform-info",
    "allow-get-system-metrics",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-recent-events",
    "allow-list-ai-models",
    "allow-get-model-routes",
    "allow-test-ai-provider",
    "allow-set-provider-api-key",
    "allow-has-provider-api-key",
    "allow-delete-provider-api-key",
    "allow-cancel-chat",
    "allow-report-ui-error",
    "allow-get-runtime-status",
    "allow-get-hardware-info",
    "allow-list-curated-models",
    "allow-check-runtime-release",
    "allow-install-runtime",
    "allow-select-runtime-binary",
    "allow-import-model",
    "allow-download-curated-model",
    "allow-download-model",
    "allow-cancel-download",
    "allow-remove-model",
    "allow-start-local-model",
    "allow-stop-local-model",
    "allow-send-message",
    "allow-list-conversations",
    "allow-get-conversation",
    "allow-create-conversation",
    "allow-update-conversation",
    "allow-delete-conversation",
    "allow-list-facts",
    "allow-save-fact",
    "allow-delete-fact",
    "allow-list-projects",
    "allow-save-project",
    "allow-delete-project",
    "allow-list-episodes",
    "allow-clear-episodes",
    "allow-search-memory",
    "allow-get-memory-status",
    "allow-export-memory",
    "allow-import-memory",
    "allow-clear-memory",
    "allow-get-agent-status",
    "allow-list-tools",
    "allow-start-agent-task",
    "allow-list-agent-tasks",
    "allow-get-agent-task",
    "allow-cancel-agent-task",
    "allow-pause-agent-task",
    "allow-resume-agent-task",
    "allow-clear-finished-agent-tasks",
    "allow-list-pending-approvals",
    "allow-resolve-approval",
    "allow-get-audit-log",
    "allow-verify-audit-log",
    "allow-add-workspace-folder"
  ]
}
