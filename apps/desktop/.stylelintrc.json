{
  "$schema": "https://json.schemastore.org/stylelintrc.json",
  "extends": ["stylelint-config-standard-scss"],
  "ignoreFiles": [".angular/**", "coverage/**", "dist/**", "node_modules/**", "src-tauri/**"],
  "rules": {
    "selector-pseudo-element-no-unknown": [true, { "ignorePseudoElements": ["ng-deep"] }],
    "selector-class-pattern": [
      "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$|^hljs-[a-z_]+$|^[a-z]+_$",
      {
        "message": "Expected class selector \"%s\" to be kebab-case (highlight.js classes excepted)"
      }
    ],
    "value-keyword-case": [
      "lower",
      { "camelCaseSvgKeywords": true, "ignoreProperties": ["/^--jv-(font|mono)$/"] }
    ]
  }
}
