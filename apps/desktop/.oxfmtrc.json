{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 130,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "associations": [
    {
      "files": ["src/**/*.html"],
      "language": "angular-html"
    }
  ],
  "ignorePatterns": [".angular/**", "coverage/**", "dist/**", "node_modules/**", "pnpm-lock.yaml", "public/**", "src-tauri/**"]
}
